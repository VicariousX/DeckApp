PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Comma-separated browser origins allowed to call this API.
# Leave empty to allow all (dev). Set this on Render.
CORS_ORIGINS=https://your-app.pages.dev,http://localhost:5173

# Load Scryfall bulk JSON into RAM. Leave false on small Render instances.
# Local dev defaults to true when NODE_ENV is not production.
BULK_ENABLED=false
